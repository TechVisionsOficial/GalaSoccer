# Copie este arquivo para .env e preencha com os valores reais.
# .env nunca deve ser commitado (já está no .gitignore).

# Postgres (Supabase) — usada pelo Prisma (client em runtime e migrations)
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public"

# Supabase (auth + storage)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Mercado Pago (checkout Pix/boleto/cartão)
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# Resend (e-mail transacional)
RESEND_API_KEY=""
