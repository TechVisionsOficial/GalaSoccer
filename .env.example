# Copie este arquivo para .env e preencha com os valores reais.
# .env nunca deve ser commitado (já está no .gitignore).

# Postgres (Supabase) — Prisma 7 usa driver adapter, então duas URLs:
# DATABASE_URL: pooler modo transação (porta 6543) — usada pelo app em runtime.
# DIRECT_URL: pooler modo sessão (porta 5432) — usada só pelas migrations.
# Pegar as duas em Supabase > Connect > ORMs > Prisma.
# sslmode=require&uselibpqcompat=true: necessário para evitar erro de certificado
# "self-signed" contra o pooler do Supabase, mantendo a conexão criptografada.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<host>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<host>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"

# Supabase (auth + storage)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Mercado Pago (checkout Pix/boleto/cartão)
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# Resend (e-mail transacional)
RESEND_API_KEY=""
